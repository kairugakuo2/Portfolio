---
import Provenance from "./Provenance.astro";

interface Props {
  slug: string;
  title: string;
  summary: string;
  date: Date;
  tags: string[];
  provenance: "production" | "domain" | "position";
  readingTime: string;
  index?: number;
}

const { slug, title, summary, date, tags, provenance, readingTime, index = 0 } =
  Astro.props;

const formatted = date.toLocaleDateString("en-US", {
  month: "short",
  year: "numeric",
});
---

<a href={`/writing/${slug}`} class="writeup-card" style={`--stagger-index:${index}`}>
  <div class="writeup-card-head">
    <h3 class="writeup-card-title">{title}</h3>
    <Provenance value={provenance} compact />
  </div>
  <p class="writeup-card-summary">{summary}</p>
  <div class="writeup-card-meta">
    <span class="duration">{formatted}</span>
    <span class="duration">{readingTime}</span>
    {tags.slice(0, 3).map((tag) => <span class="skill-tag">{tag}</span>)}
  </div>
  <span class="writeup-card-cta">read →</span>
</a>
