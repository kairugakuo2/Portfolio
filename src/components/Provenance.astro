---
// The honesty layer, rendered. Each essay declares what kind of evidence backs
// it so a reader never has to guess whether something was shipped or theorized.
interface Props {
  value: "production" | "domain" | "position";
  compact?: boolean;
}

const { value, compact = false } = Astro.props;

const labels = {
  production: {
    tag: "grounded in production work",
    detail:
      "Written from code I wrote and can point you at. The repository is linked below.",
  },
  domain: {
    tag: "domain writeup",
    detail:
      "This explains the general problem class, not any employer's implementation. It contains no proprietary architecture, and nothing here is specific to a system I've worked on under NDA.",
  },
  position: {
    tag: "position piece — not yet built",
    detail:
      "A researched argument about how I would approach this problem. I have not shipped a system doing this; treat it as reasoning, not experience.",
  },
} as const;

const { tag, detail } = labels[value];
---

{
  compact ? (
    <span class:list={["provenance-chip", `provenance-${value}`]}>{tag}</span>
  ) : (
    <aside class:list={["provenance", `provenance-${value}`]}>
      <span class="provenance-tag">{tag}</span>
      <p class="provenance-detail">{detail}</p>
    </aside>
  )
}
