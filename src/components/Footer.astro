---
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="footer">
  <span class="footer-name">{site.name}</span>
  <div class="footer-social">
    <a href={`mailto:${site.email}`} aria-label="Email">{site.email}</a>
    <a href={site.github} target="_blank" rel="noreferrer">GitHub</a>
    <a href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
  </div>
  <div class="status-bar" aria-hidden="true">
    <div class="status-group">
      <span class="status-item">⎇ main</span>
      <span class="status-item">{site.location}</span>
    </div>
    <div class="status-group">
      <span class="status-item">UTF-8</span>
      <span class="status-item" data-status-theme>theme</span>
    </div>
  </div>
  <span class="footer-copyright">&copy; {year} {site.name}. Built with Astro.</span>
</footer>

<script>
  import { getTheme, subscribe } from "../lib/theme";

  const el = document.querySelector("[data-status-theme]");
  if (el) {
    const render = (theme: string) => { el.textContent = theme; };
    render(getTheme());
    subscribe(render);
  }
</script>
