---
import { palettes, portraits } from '../data/palettes';
import Portrait from '../components/Portrait.astro';
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Choose your direction — Gakuo Kairu</title><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Instrument+Serif:ital@0;1&family=IBM+Plex+Mono&display=swap" rel="stylesheet"/></head>
<body>
<header><a href="/">gk<span> / DESIGN ROOM</span></a><p>Try a combination. Tell me the name + letter.</p><a id="full-preview" href="/?palette=lichen&portrait=halo" target="_blank">Open full preview ↗</a></header>
<main><aside><div class="picker-intro"><h1>Find your <em>frequency.</em></h1><p>10 palettes. 4 portraits. Same you.<br />Selections only change this preview.</p></div><h2>01 / THE PALETTE</h2><div class="palette-grid">{palettes.map((p,i)=><button class="palette-option" data-palette={p.id} aria-pressed={i===0} style={`--p-bg:${p.colors[0]};--p-surface:${p.colors[1]};--p-text:${p.colors[2]};--p-accent:${p.colors[5]}`}><span class="palette-sample"><span class="sample-name">Gakuo<span>.</span></span><span class="sample-rule"></span><span class="swatches">{[p.colors[0],p.colors[1],p.colors[2],p.colors[5]].map(c=><i style={`background:${c}`}></i>)}</span></span><span class="palette-name">{String(i+1).padStart(2,'0')} {p.name}</span><span class="palette-note">{p.note}</span></button>)}</div>
<h2>02 / THE PORTRAIT</h2><div class="portrait-options">{portraits.map((p,i)=><button data-portrait={p.id} class="portrait-option" aria-pressed={i===0}><Portrait treatment={p.id} small/><strong>{p.name}</strong><span>{p.note}</span></button>)}</div>
<div class="selection"><span>YOUR COMBINATION</span><p id="selection-text" aria-live="polite">Lichen + A / Quiet halo</p><button id="copy-choice">Copy my choice</button><p id="copy-status" role="status"></p></div>
<div class="resume-note"><h2>RÉSUMÉ UPDATES INCLUDED</h2><p>Gedis and Morning Negotiation join Sooner Planner as selected work. Argo now reflects 8 microservices, 60-second key convergence, and 56 tests. Founding Team Member title corrected; Go and AI/MCP skills added.</p><p>Portrait is an AI-assisted background cutout. Original photograph is preserved.</p></div>
</aside><section class="preview-column"><div class="preview-label"><span>LIVE SITE PREVIEW</span><span id="preview-name">01 / Lichen</span><button id="jump-photo">Show portrait ↓</button></div><iframe id="site-preview" title="Your portfolio with the selected palette and portrait" src="/?palette=lichen&portrait=halo"></iframe></section></main>
<script is:inline define:vars={{palettes,portraits}}>
  let palette = palettes[0]; let portrait = portraits[0];
  const frame = document.getElementById('site-preview');
  function update(scrollToPhoto=false){
    const query = '?palette='+palette.id+'&portrait='+portrait.id;
    frame.src = '/'+query+(scrollToPhoto?'#about':'');
    document.getElementById('full-preview').href='/'+query;
    document.getElementById('selection-text').textContent=palette.name+' + '+portrait.name;
    document.getElementById('preview-name').textContent=String(palettes.indexOf(palette)+1).padStart(2,'0')+' / '+palette.name;
    document.querySelectorAll('[data-palette]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.palette===palette.id)));
    document.querySelectorAll('[data-portrait]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.portrait===portrait.id)));
    const keys=['bg','bg-elevated','text','text-muted','border','accent'];
    keys.forEach((key,i)=>document.querySelector('.portrait-options').style.setProperty('--color-'+key,palette.colors[i]));
    document.getElementById('copy-status').textContent='';
    history.replaceState(null,'', '?palette='+palette.id+'&portrait='+portrait.id);
  }
  document.querySelectorAll('[data-palette]').forEach(b=>b.addEventListener('click',()=>{palette=palettes.find(p=>p.id===b.dataset.palette);update()}));
  document.querySelectorAll('[data-portrait]').forEach(b=>b.addEventListener('click',()=>{portrait=portraits.find(p=>p.id===b.dataset.portrait);update(true)}));
  document.getElementById('jump-photo').addEventListener('click',()=>update(true));
  document.getElementById('copy-choice').addEventListener('click',async()=>{try{await navigator.clipboard.writeText('Use '+palette.name+' with portrait '+portrait.name+' on my portfolio.');document.getElementById('copy-status').textContent='Copied. Paste it into our chat.'}catch{document.getElementById('copy-status').textContent='Tell me: '+palette.name+' + '+portrait.name}});
  const params=new URLSearchParams(location.search);palette=palettes.find(p=>p.id===params.get('palette'))||palette;portrait=portraits.find(p=>p.id===params.get('portrait'))||portrait;update();
</script>
<style is:global>
*{box-sizing:border-box}body{margin:0;background:#f4f2ed;color:#252520;font:14px 'DM Sans',sans-serif;--font-mono:'IBM Plex Mono',monospace;--color-bg:#191b18;--color-bg-elevated:#21241f;--color-text:#e8e9df;--color-border:#363a30;--color-accent:#d7ed93}a{color:inherit;text-decoration:none}button{font:inherit;cursor:pointer}button:focus-visible,a:focus-visible{outline:3px solid #8a4e28;outline-offset:3px}header{padding:20px 30px;border-bottom:1px solid #d5d2c8;display:flex;align-items:center;justify-content:space-between;gap:20px}header>a:first-child{font-size:26px;font-weight:600;letter-spacing:-1px}header span{font:9px var(--font-mono);letter-spacing:1px}header p,header>a:last-child{font-size:12px}main{display:grid;grid-template-columns:410px minmax(0,1fr)}aside{padding:30px;border-right:1px solid #d5d2c8}.picker-intro h1{font-weight:500;font-size:34px;letter-spacing:-1.3px;margin:0 0 12px}.picker-intro em{font-family:'Instrument Serif',serif;font-size:1.1em}.picker-intro p{color:#69685e;font-size:12px;line-height:1.7;margin-bottom:32px}h2{font:10px var(--font-mono);letter-spacing:1px;margin:28px 0 18px}.palette-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px 12px}.palette-option{border:0;background:none;padding:0;text-align:left;display:block;min-width:0}.palette-sample{display:block;background:var(--p-bg);color:var(--p-text);padding:15px 12px 12px;outline:1px solid #0001;outline-offset:3px;border-radius:2px}.palette-option[aria-pressed=true] .palette-sample{outline:2px solid #252520}.sample-name{font-size:29px;letter-spacing:-1.5px;display:block}.sample-name>span{color:var(--p-accent)}.sample-rule{height:1px;background:var(--p-text);opacity:.2;display:block;margin:18px 0 12px}.swatches{display:flex;gap:5px}.swatches i{width:17px;height:17px;border-radius:50%;border:1px solid #ffffff20}.palette-name{display:block;font-size:11px;margin:10px 0 4px;font-weight:600}.palette-note{font-size:10px;line-height:1.4;color:#69685e;display:block}.portrait-options{display:grid;grid-template-columns:1fr 1fr;gap:20px 12px}.portrait-option{padding:0;border:0;background:none;text-align:left;min-width:0}.portrait-option[aria-pressed=true] .portrait-art{outline:2px solid #252520;outline-offset:3px}.portrait-option strong{display:block;font-size:11px;margin:12px 0 5px}.portrait-option>span{font-size:10px;line-height:1.5;color:#69685e;display:block}.selection{padding:24px 0;margin-top:25px;border-top:1px solid #d5d2c8}.selection>span{font:9px var(--font-mono)}.selection>p{font-size:17px}.selection button{background:#252520;color:#fff;border:0;padding:12px 18px;border-radius:3px}.selection #copy-status{font-size:11px;min-height:16px}.resume-note{font-size:12px;color:#69685e;line-height:1.7}.preview-column{position:sticky;top:0;align-self:start;height:100vh;min-width:0;background:#dcdad3;padding:22px}.preview-label{display:flex;justify-content:space-between;align-items:center;gap:10px;height:30px;margin-bottom:16px;font:9px var(--font-mono)}.preview-label button{background:transparent;border:0;border-bottom:1px solid #777;font-size:10px;padding:8px 0}iframe{width:100%;height:calc(100% - 46px);border:0;background:#191b18;border-radius:4px}@media(max-width:1000px){main{grid-template-columns:350px minmax(0,1fr)}aside{padding:22px}.preview-column{padding:12px}.preview-label>span:first-child{display:none}}@media(max-width:700px){header{padding:16px;flex-wrap:wrap}header p{display:none}main{display:flex;flex-direction:column}aside{border:0;padding:25px}.preview-column{position:relative;order:-1;height:65vh;width:100%}.palette-grid{grid-template-columns:repeat(2,1fr)}.picker-intro h1{font-size:32px}.preview-label>span:first-child{display:block}}
</style></body></html>
