---
import Base from "../../layouts/Base.astro";
import Provenance from "../../components/Provenance.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("writing", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const published = entry.data.date.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});
const updated = entry.data.updated?.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});

// Only h2s — the table of contents is a map, not an outline.
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <article class="writeup">
    <header class="writeup-head">
      <a href="/writing" class="back-link">← all writing</a>
      <h1>{entry.data.title}</h1>
      <p class="writeup-summary">{entry.data.summary}</p>
      <div class="writeup-meta">
        <span class="duration">{published}</span>
        {updated && <span class="duration">updated {updated}</span>}
        <span class="duration">{entry.data.readingTime}</span>
      </div>
      <div class="skills-container">
        {entry.data.tags.map((tag) => <span class="skill-tag">{tag}</span>)}
      </div>
      <Provenance value={entry.data.provenance} />
    </header>

    {
      toc.length > 2 && (
        <nav class="toc" aria-label="Table of contents">
          <p class="toc-title">contents</p>
          <ol>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <footer class="writeup-foot">
      <a href="/writing" class="back-link">← all writing</a>
    </footer>
  </article>
</Base>
