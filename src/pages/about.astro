---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { experience, otherWork, leadership } from "../data/experience";
import { skillGroups } from "../data/skills";
import myImage from "../assets/me.jpeg";
import { Image } from "astro:assets";
---

<Base title="About" description={`${site.tagline} ${site.subline}`}>
  <section class="page-head">
    <h1>/ about</h1>
  </section>

  <div class="about-layout">
    <div class="about-text prose">
      <p>
        I'm a Computer Science student at the University of Oklahoma, graduating
        May 2027. I work on the parts of a system that other systems depend on —
        identity, key material, and the APIs in between.
      </p>
      <p>
        Right now that means interning at <strong>Argo Data</strong>, building a
        zero-trust identity subsystem in C# and .NET 8 for banking
        infrastructure operating under GLBA and HIPAA. The work is signing key
        bootstrapping and rotation: how a service proves who it is without a
        human ever copying a secret between machines, and what happens when the
        component that issues those keys goes down mid-rotation.
      </p>
      <p>
        That last question is the one I find genuinely interesting. Most of
        security engineering is not the cryptography — it's the failure modes
        around it. A key rotation that works perfectly is easy. A key rotation
        that has to survive a registrar outage, a half-committed state, and a
        clock skew is the actual job.
      </p>
      <p>
        Before this I ran a mobile detailing business, led a 5-person team
        through a full software project as technical lead, and spent two years
        maintaining department web and desktop applications at OU's Language
        Learning Center. I like problems where the constraint is real.
      </p>
      <p>
        Outside of work I'm usually reading about vulnerability classes, playing
        too many video games, or cooking.
      </p>
    </div>
    <div class="about-image">
      <Image src={myImage} alt="Gakuo Kairu" widths={[320, 480]} sizes="(max-width: 768px) 80vw, 400px" />
    </div>
  </div>

  <section class="home-section">
    <h2>/ skills</h2>
    <div class="skills-groups">
      {
        skillGroups.map((group, index) => (
          <div class="skills-group" style={`--stagger-index:${index}`}>
            <h4 class="skills-group-title">{group.category}</h4>
            <div class="skills-container">
              {group.items.map((item) => (
                <span class="skill-tag">{item}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="home-section">
    <h2>/ git log --experience</h2>
    <div class="experience-grid">
      {
        experience.map((exp, index) => (
          <div class="experience-card" style={`--stagger-index:${index}`}>
            <div class="experience-header">
              <h3 class="company-name">{exp.company}</h3>
              <span class="duration">
                <span class="commit-hash">{exp.hash}</span>
                {" · "}
                {exp.from} {" → "}
                {exp.to === "HEAD" ? <span class="head-ref">HEAD</span> : exp.to}
              </span>
            </div>
            <h4 class="job-title">
              {exp.title} <span class="job-location">· {exp.location}</span>
            </h4>
            <p class="job-description">{exp.description}</p>
            <ul class="card-bullets">
              {exp.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
            <div class="skills-container">
              {exp.skills.map((skill) => (
                <span class="skill-tag">{skill}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="home-section">
    <h2>/ education</h2>
    <div class="experience-card">
      <div class="experience-header">
        <h3 class="company-name">{site.education.school}</h3>
        <span class="duration">Expected {site.education.graduation}</span>
      </div>
      <h4 class="job-title">{site.education.degree}</h4>
      <p class="job-description">Relevant coursework:</p>
      <div class="skills-container">
        {site.education.coursework.map((course) => <span class="skill-tag">{course}</span>)}
      </div>
    </div>
  </section>

  <section class="home-section">
    <h2>/ leadership</h2>
    <div class="experience-grid">
      {
        leadership.map((role, index) => (
          <div class="experience-card" style={`--stagger-index:${index}`}>
            <div class="experience-header">
              <h3 class="company-name">{role.organization}</h3>
              <span class="duration">{role.duration}</span>
            </div>
            <h4 class="job-title">{role.title}</h4>
            <p class="job-description">{role.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="home-section">
    <h2>/ before software</h2>
    {
      otherWork.map((work) => (
        <div class="experience-card">
          <div class="experience-header">
            <h3 class="company-name">{work.company}</h3>
            <span class="duration">
              {work.from} → {work.to}
            </span>
          </div>
          <h4 class="job-title">{work.title}</h4>
          <p class="job-description">{work.description}</p>
        </div>
      ))
    }
  </section>
</Base>
