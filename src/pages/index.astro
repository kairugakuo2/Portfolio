---
import Base from "../layouts/Base.astro";
import Portrait from "../components/Portrait.astro";
import DetailModal from "../components/DetailModal.astro";
import { site } from "../data/site";
import { experience, leadership, otherWork } from "../data/experience";
import { skillGroups } from "../data/skills";
const [major, minor] = site.education.degree.replace("B.S. ", "").split(", Minor in ");
---
<Base>
  <section class="intro" aria-labelledby="intro-title">
    <div class="intro-meta"><span><i class="status-dot"></i> SOFTWARE ENGINEER</span><span>NORMAN, OK · 35.22° N</span></div>
    <h1 id="intro-title">Gakuo<span class="name-last">Kairu<span class="name-period">.</span></span></h1>
    <div class="intro-bottom"><p>I build the parts<br />other systems <em>depend on.</em></p><div><p class="intro-description">Distributed systems. Secure APIs.<br />Agents that work things out.</p><a class="text-link" href="#projects">Explore selected work <span>↘</span></a></div></div>
    <div class="hero-index"><span>PORTFOLIO / 2026</span><span>SCROLL TO EXPLORE ↓</span></div>
  </section>

  <section id="projects" class="work-section">
    <div class="section-heading"><span class="eyebrow">01 / SELECTED WORK</span><span class="section-note">A few things I've put my mind to.</span></div>
    <article class="featured-work">
      <div class="work-copy"><span class="eyebrow">SYSTEMS / GO</span><h2>Built from bytes.<br /><em>Made to persist.</em></h2><p>Gedis: a Redis-compatible server, built from raw TCP sockets. Concurrent clients, a custom protocol parser, and storage that survives a restart.</p><div class="work-stack">Go · TCP · RESP · Concurrency</div><button class="text-link" data-detail-id="gedis" aria-haspopup="dialog">Inside the project <span>↗</span></button><span class="work-number" aria-hidden="true">001</span></div>
      <div class="trace-panel">
        <div class="instrument-header"><span><i class="status-dot"></i> PROTOCOL LAB</span><span>01 — 03</span></div>
        <div class="trace-art" aria-hidden="true"><svg viewBox="0 0 520 260" fill="none"><defs><pattern id="dots" width="20" height="20" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="currentColor" opacity=".15"/></pattern></defs><rect width="520" height="260" fill="url(#dots)"/><path class="trace-path" d="M50 130H200L260 70L320 130H470"/><path d="M260 190V230M260 30V70" stroke="currentColor" opacity=".18"/><rect x="218" y="88" width="84" height="84" transform="rotate(45 260 130)" fill="var(--color-bg-elevated)" stroke="var(--color-accent)"/><circle cx="50" cy="130" r="7" fill="var(--color-text)"/><circle class="trace-end" cx="470" cy="130" r="7" fill="var(--color-accent)"/><path class="trace-check" d="M248 130l8 8 17-17" stroke="var(--color-accent)" stroke-width="2"/><path class="trace-cross" d="m250 120 20 20m0-20-20 20" stroke="#eb9b80" stroke-width="2"/><text x="50" y="172" text-anchor="middle">INPUT</text><text x="260" y="222" text-anchor="middle">VALIDATE</text><text x="465" y="172" text-anchor="middle">STORE</text><circle class="packet" r="4" fill="var(--color-accent)"><animateMotion dur="3s" repeatCount="indefinite" path="M50 130H200L260 70L320 130H470"/></circle></svg></div>
        <div class="trace-controls" role="group" aria-label="Choose an illustrative request"><button class="trace-choice active" data-scenario="valid" aria-pressed="true">Valid command</button><button class="trace-choice" data-scenario="blocked" aria-pressed="false">Malformed frame</button></div>
        <div class="trace-result" aria-live="polite"><code id="trace-input">SET hello world</code><span id="trace-status">+OK · Stored</span></div>
        <p class="instrument-foot">INTERACTIVE SCHEMATIC <span>ILLUSTRATIVE, NO REQUESTS SENT</span></p>
      </div>
    </article>
    <div class="secondary-work">
      <button class="project-tile planner-tile" data-detail-id="sooner-planner" aria-haspopup="dialog">
        <div class="tile-visual planner-visual" aria-hidden="true"><div class="mini-calendar"><div class="calendar-top"><span>A week, well arranged.</span><span>↗</span></div><div class="calendar-days"><span>MON</span><span>TUE</span><span>WED</span><span>THU</span><span>FRI</span></div><div class="calendar-grid"><span class="class-block b1">CS 3113<br /><small>Operating Systems</small></span><span class="class-block b2">MATH<br /><small>Linear Algebra</small></span><span class="class-block b3">CS 3113</span><span class="class-block b4">Open afternoon</span><span class="class-block b5">CS 3823</span></div></div><span class="visual-caption">SCHEDULE CONCEPT / SOONER PLANNER</span></div>
        <div class="tile-caption"><div><span class="eyebrow">002 / PRODUCT ENGINEERING</span><h3>Sooner Planner</h3><p>1,000+ possibilities. Your kind of week.</p></div><span class="tile-arrow">↗</span></div>
      </button>
      <button class="project-tile study-tile" data-detail-id="morning-negotiation" aria-haspopup="dialog">
        <div class="tile-visual study-visual" aria-hidden="true"><div class="study-orbit orbit-one"></div><div class="study-orbit orbit-two"></div><div class="study-orbit orbit-three"></div><span class="study-word">Two minds.<br /><em>One morning.</em></span><div class="study-members"><span>A</span><span>B</span></div><span class="visual-caption">TWO AGENTS. ONE DAILY RECOMMENDATION.</span></div>
        <div class="tile-caption"><div><span class="eyebrow">003 / AI & AGENT SYSTEMS</span><h3>Morning Negotiation</h3><p>Local inference. Live data. A negotiated plan.</p></div><span class="tile-arrow">↗</span></div>
      </button>
    </div>
  </section>

  <section id="experience" class="experience-section"><div class="section-heading"><span class="eyebrow">02 / ALONG THE WAY</span><span class="section-note">The places. The people. The work.</span></div>
    {experience.map((exp,index)=><button class="experience-row" data-detail-id={exp.id} aria-haspopup="dialog"><span class="exp-index">0{index+1}</span><div><h3>{exp.company}</h3><p>{exp.title}</p></div><span class="exp-date">{exp.from} — {exp.to === "HEAD" ? "NOW" : exp.to}</span><span class="row-arrow">↗</span></button>)}
    <div class="subsection-label"><span class="eyebrow">LEADERSHIP</span></div>
    {leadership.map((org)=><button class="experience-row leadership-row" data-detail-id={org.id} aria-haspopup="dialog"><span class="exp-index">★</span><div><h3>{org.organization}</h3><p><span class="role-current">{org.roles[0].title}</span>{org.roles.slice(1).map(r=><span class="role-past"> · previously {r.title}</span>)}</p></div><span class="exp-date">{org.roles[org.roles.length - 1].from} — {org.roles[0].to === "HEAD" ? "NOW" : org.roles[0].to}</span><span class="row-arrow">↗</span></button>)}
    {otherWork.map((w)=><p class="also-line"><span class="eyebrow">ALSO</span> {w.title}, <strong>{w.company}</strong> <span class="exp-date">{w.from} — {w.to}</span><span class="also-detail">{w.description}</span></p>)}
  </section>

  <section id="skills" class="foundations-section" aria-labelledby="foundations-title">
    <div class="section-heading"><span class="eyebrow">03 / THE FOUNDATIONS</span><span class="section-note">What I study. What I build with.</span></div>
    <div class="foundations-grid">
      <div class="edu-card">
        <span class="eyebrow">EDUCATION</span>
        <h2 id="foundations-title">{site.education.school}</h2>
        <dl class="degree-list">
          <div><dt>MAJOR</dt><dd>B.S. {major}</dd></div>
          <div><dt>MINOR</dt><dd>{minor}</dd></div>
          <div><dt>GRADUATING</dt><dd><em>{site.education.graduation}</em></dd></div>
        </dl>
        <span class="eyebrow mini-label">RELEVANT COURSEWORK</span>
        <ul class="course-list">{site.education.coursework.map(c=><li>{c}</li>)}</ul>
      </div>
      <div class="skills-index">
        <span class="eyebrow">TOOLKIT</span>
        {skillGroups.map(g=><div class="skill-row"><span class="skill-cat">{g.category}</span><span class="skill-items">{g.items.join(" · ")}</span></div>)}
      </div>
    </div>
  </section>

  <section id="about" class="about-section"><div class="about-photo"><Portrait treatment="halo" /><span class="photo-caption">GAKUO, OFFLINE.</span></div><div class="about-content"><span class="eyebrow">04 / THE PERSON BEHIND THE WORK</span><h2>Curious by default.<br /><em>Careful by design.</em></h2><p>I'm Gakuo, a computer science student at the University of Oklahoma. I care about the quiet details that make software trustworthy — identity, security, and what happens when things don't go to plan.</p><p>At Argo Data, I shipped request signing across eight microservices, with zero-downtime key rotation and 56 unit tests. Along the way: a mobile detailing business, a five-person software team, and tools for my university.</p><p class="personal-note">Away from the keyboard: cooking, video games, and one more rabbit hole.</p><div class="education-line"><span>UNIVERSITY OF OKLAHOMA</span><span>CS + MIS · MAY 2027</span></div></div></section>

  <section id="contact" class="contact-section"><div class="section-heading"><span class="eyebrow">05 / WHAT'S NEXT?</span><span class="availability"><i class="status-dot"></i> OPEN TO SUMMER 2027 INTERNSHIPS</span></div><a class="contact-title" href={`mailto:${site.email}`}>Let's build<br /><em>something solid.</em><span>↗</span></a><div class="contact-bottom"><a href={`mailto:${site.email}`}>{site.email}</a><p>Good systems start with a conversation.</p></div></section>
  <DetailModal />
</Base>
<script>
  const chosenPortrait = document.documentElement.dataset.portraitPreview;
  if (chosenPortrait) {
    const art = document.querySelector('.about-photo .portrait-art');
    if (art) art.className = 'portrait-art portrait-' + chosenPortrait;
  }
  const choices = document.querySelectorAll<HTMLButtonElement>('.trace-choice');
  choices.forEach(button => button.addEventListener('click', () => {
    const blocked = button.dataset.scenario === 'blocked';
    choices.forEach(choice => { const active = choice === button; choice.classList.toggle('active', active); choice.setAttribute('aria-pressed', String(active)); });
    document.querySelector('.trace-panel')?.classList.toggle('is-blocked', blocked);
    document.getElementById('trace-input')!.textContent = blocked ? 'Invalid length prefix' : 'SET hello world';
    document.getElementById('trace-status')!.textContent = blocked ? 'Rejected before allocation' : '+OK · Stored';
  }));
</script>
